# Copy to .env and fill in. Never commit .env or data/.
# The wallets published with the old public build are leaked. Generate new
# wallets and do not fund FLAgPA3VzRhAC8auZAoS4FNeqah4vKuf5CEL49i2SMcy
# or the sub-wallets that were saved beside it.

# Required on every /api request and WebSocket upgrade.
# Leave blank to generate one at startup (printed once, stored in data/api-token mode 0600).
API_TOKEN=

# Helius. Required before the dashboard switch can enter live mode.
# LIVE_TRADING and SIMULATION_MODE are ignored. The process always starts in simulation.
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_WS_URL=
SOLANA_PUBLIC_RPC_URL=https://api.mainnet.solana.com

# Optional QuickNode fallback. Used when Helius is unhealthy or out of credits.
# QUICKNODE_RPC_URL=https://your-endpoint.quiknode.pro/REPLACE_ME
# QUICKNODE_WS_URL=wss://your-endpoint.quiknode.pro/REPLACE_ME
# Requests per second. QuickNode's free plan allows 15; the default stays under that.
# Set a value to unlimited to turn the bucket off. RPC_DEBUG=1 logs one line per provider each minute.
# QUICKNODE_RPS=12
# HELIUS_RPS is unlimited when unset. Set a number only to throttle Helius.
# PUBLIC_RPS=4

# Optional Alchemy fallback, after QuickNode. Free plan allows 15 requests/second; the default stays under that.
# ALCHEMY_API_KEY=REPLACE_ME
# ALCHEMY_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/REPLACE_ME
# ALCHEMY_WS_URL=wss://solana-mainnet.g.alchemy.com/v2/REPLACE_ME
# ALCHEMY_RPS=12
# Optional. When today's HTTP calls reach this number, that provider is skipped until the next UTC day.
# ALCHEMY_DAILY_BUDGET=300000

HOST=127.0.0.1
PORT=3000

# Spend caps. Raises require an edit here and a restart.
MAX_SOL_PER_TRADE=0.1
MAX_SOL_PER_SESSION=0.5
MAX_JITO_TIP_SOL=0.01
DEFAULT_JITO_TIP=0.003

# Trade defaults. Slippage is a percent. Priority fee is SOL.
SLIPPAGE_PCT=10
PRIORITY_FEE_SOL=0.0001

HTTP_TIMEOUT_MS=20000
MIN_BUMP_INTERVAL_SEC=5
BUNDLE_POLL_TIMEOUT_MS=45000
BUNDLE_POLL_INTERVAL_MS=1500

JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles

# Second-pump market cap in USD. A coin whose peak stays below this arms the bleed exit after pump 1.
SECOND_PUMP_MCAP_USD=100000
BLEED_FLOOR_MCAP_USD=50000
PUMP_MIN_RISE_PCT=50
PUMP_MIN_DRAWDOWN_PCT=25
NEAR_MIGRATION_PCT=90

# Opt-in sim strategy. Leave at 0. Live ignores it and only shows the alert.
FARM_RIDE_ENABLED=0
FARM_RIDE_MAX_SOL=0.02
FARM_RIDE_KOL_WINDOW_MS=600000
FARM_RIDE_STOP_PCT=25
FARM_RIDE_MAX_HOLD_MS=1800000

# Pump.fun frontend API. v3 is the live host. 403 and 5xx fall back to v2, then the original host.
PUMP_API_BASE=https://frontend-api-v3.pump.fun

# Optional. PumpPortal trade streaming now requires a key funded with at least 0.02 SOL.
# Leave blank to use the free Helius bonding-curve feed only.
PUMPPORTAL_API_KEY=
