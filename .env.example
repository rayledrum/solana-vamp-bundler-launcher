# Copy to .env and fill in. Never commit .env or data/.
# The wallets published with the old public build are leaked. Generate new
# wallets and do not fund FLAgPA3VzRhAC8auZAoS4FNeqah4vKuf5CEL49i2SMcy
# or the sub-wallets that were saved beside it.

# Required on every /api request and WebSocket upgrade.
# Leave blank to generate one at startup (printed once, stored in data/api-token mode 0600).
API_TOKEN=

# Helius. Required before the dashboard switch can enter live mode.
# LIVE_TRADING and SIMULATION_MODE are ignored. The process always starts in simulation.
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_WS_URL=
SOLANA_PUBLIC_RPC_URL=https://api.mainnet.solana.com

HOST=127.0.0.1
PORT=3000

# Spend caps. Raises require an edit here and a restart.
MAX_SOL_PER_TRADE=0.1
MAX_SOL_PER_SESSION=0.5
MAX_JITO_TIP_SOL=0.01
DEFAULT_JITO_TIP=0.003

# Trade defaults. Slippage is a percent. Priority fee is SOL.
SLIPPAGE_PCT=10
PRIORITY_FEE_SOL=0.0001

HTTP_TIMEOUT_MS=20000
MIN_BUMP_INTERVAL_SEC=5
BUNDLE_POLL_TIMEOUT_MS=45000
BUNDLE_POLL_INTERVAL_MS=1500

JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles

# Pump.fun frontend API. v3 is the live host. 403 and 5xx fall back to v2, then the original host.
PUMP_API_BASE=https://frontend-api-v3.pump.fun

# Optional. PumpPortal trade streaming now requires a key funded with at least 0.02 SOL.
# Leave blank to use the free Helius bonding-curve feed only.
PUMPPORTAL_API_KEY=
